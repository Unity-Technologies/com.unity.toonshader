root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{cs,py,shader,compute,hlsl,cginc}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,meta}]
indent_style = space
indent_size = 2

[*.{sh,bat}]
indent_style = space
indent_size = 2
